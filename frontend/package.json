{
  "name": "meiday-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/clean-sourcemaps.mjs",
    "build:web": "vue-tsc --noEmit && vite build --mode web && node scripts/clean-sourcemaps.mjs",
    "preview": "vite preview",
    "cert": "node gen-cert.mjs",
    "apk:sync": "npm run build && cap sync android",
    "apk:debug": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "build:plugin": "vite build --config vite.config.plugin.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "aws4fetch": "^1.0.20",
    "jszip": "^3.10.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.5.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.1",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
